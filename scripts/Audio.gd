extends Node
## Autoload "Audio": music + sound effects on separate buses with volume control.
## All audio files are generated by tools/gen_audio.py (see README).

const MUSIC_BUS := "Music"
const SFX_BUS := "SFX"

var _music: AudioStreamPlayer
var _voice: AudioStreamPlayer
var _sfx_pool: Array = []
var _streams: Dictionary = {}
var _current_music: String = ""
var _volumes: Dictionary = {"Music": 0.55, "SFX": 0.9}
## game sound name -> file in assets/audio (Brackeys sounds reused under these names)
const ALIAS := {"stomp": "explosion", "death": "hurt", "lift": "power_up", "transition": "power_up", "click": "tap"}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_bus(MUSIC_BUS)
	_ensure_bus(SFX_BUS)
	var lp := AudioEffectLowPassFilter.new()
	lp.cutoff_hz = 1400.0
	var mi := AudioServer.get_bus_index(MUSIC_BUS)
	AudioServer.add_bus_effect(mi, lp)
	AudioServer.set_bus_effect_enabled(mi, AudioServer.get_bus_effect_count(mi) - 1, false)
	_music = AudioStreamPlayer.new()
	_music.bus = MUSIC_BUS
	_music.finished.connect(_on_music_finished)
	add_child(_music)
	_voice = AudioStreamPlayer.new()
	_voice.bus = SFX_BUS
	add_child(_voice)
	for i in range(8):
		var p := AudioStreamPlayer.new()
		p.bus = SFX_BUS
		add_child(p)
		_sfx_pool.append(p)
	set_volume(MUSIC_BUS, _volumes[MUSIC_BUS])
	set_volume(SFX_BUS, _volumes[SFX_BUS])


func _ensure_bus(bus_name: String) -> void:
	if AudioServer.get_bus_index(bus_name) != -1:
		return
	AudioServer.add_bus()
	var i := AudioServer.bus_count - 1
	AudioServer.set_bus_name(i, bus_name)
	AudioServer.set_bus_send(i, "Master")


func _stream(sound_name: String) -> AudioStream:
	var file: String = ALIAS.get(sound_name, sound_name)
	if not _streams.has(file):
		var found: AudioStream = null
		for ext in ["wav", "mp3"]:
			var path := "res://assets/audio/%s.%s" % [file, ext]
			if ResourceLoader.exists(path):
				found = load(path)
				break
		if found is AudioStreamMP3:
			found.loop = true
		_streams[file] = found
	return _streams[file]


func set_volume(bus_name: String, linear: float) -> void:
	_volumes[bus_name] = clampf(linear, 0.0, 1.0)
	var idx := AudioServer.get_bus_index(bus_name)
	if idx == -1:
		return
	AudioServer.set_bus_volume_db(idx, -80.0 if linear <= 0.001 else linear_to_db(linear))


func get_volume(bus_name: String) -> float:
	return _volumes.get(bus_name, 1.0)


## Brackeys ships one music track, so each dimension plays it with a different
## pitch (Heaven brighter, Hell slowed + muffled by a low-pass filter on the Music bus).
func play_music(track: String, pitch: float = 1.0, muffled: bool = false) -> void:
	_music.pitch_scale = pitch
	var mi := AudioServer.get_bus_index(MUSIC_BUS)
	AudioServer.set_bus_effect_enabled(mi, AudioServer.get_bus_effect_count(mi) - 1, muffled)
	if track == _current_music and _music.playing:
		return
	_current_music = track
	var s := _stream(track)
	if s == null:
		_music.stop()
		return
	_music.stream = s
	_music.play()


func stop_music() -> void:
	_current_music = ""
	_music.stop()


func _on_music_finished() -> void:
	if _current_music != "":
		_music.play()


func play_sfx(sound_name: String, volume_db: float = 0.0) -> void:
	var s := _stream(sound_name)
	if s == null:
		return
	for p in _sfx_pool:
		if not p.playing:
			p.stream = s
			p.volume_db = volume_db
			p.play()
			return
	# all busy: steal the first
	_sfx_pool[0].stream = s
	_sfx_pool[0].volume_db = volume_db
	_sfx_pool[0].play()


func play_voice(sound_name: String) -> void:
	var s := _stream(sound_name)
	if s == null:
		return
	_voice.stream = s
	_voice.play()
